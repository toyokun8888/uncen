{
  "name": "collection-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Local collection ledger for scraped masters, owned files, downloadable links, and browser views.",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:node": "node --check apps/jobs/health-check.js",
    "check:master": "node --check apps/jobs/master-pipeline.js",
    "check:common-master": "node --check apps/jobs/common-master-pipeline.js",
    "check:dl-reference": "node --check apps/jobs/dl-reference-pipeline.js",
    "check:video-metadata": "node --check apps/jobs/collect-video-metadata.js",
    "check:api": "node --check apps/api/src/server.js",
    "check:owned-file": "node --check apps/jobs/owned-file-pipeline.js",
    "check:move:paco": "node --check apps/jobs/move-paco-files.js",
    "check:owned-relations": "node --check apps/jobs/check-owned-relations.js",
    "check:thumb:paco": "node --check apps/jobs/collect-paco-thumbnails.js",
    "check:rename:paco:owned": "node --check apps/jobs/rename-paco-owned-files.js",
    "job:health": "node apps/jobs/health-check.js",
    "job:master:paco:init-db": "node apps/jobs/master-pipeline.js --source paco --step init-db",
    "job:master:paco:db-status": "node apps/jobs/master-pipeline.js --source paco --step db-status",
    "job:master:paco:dry-run": "node apps/jobs/master-pipeline.js --source paco --step collect --dry-run --limit 10 --max-pages 1",
    "job:common-master:init-db": "node apps/jobs/common-master-pipeline.js --step init-db",
    "job:common-master:seed-paco": "node apps/jobs/common-master-pipeline.js --step seed-paco --source paco",
    "job:common-master:status": "node apps/jobs/common-master-pipeline.js --step status",
    "job:dl-reference:paco:init-db": "node apps/jobs/dl-reference-pipeline.js --source paco --step init-db",
    "job:dl-reference:paco:dry-run": "node apps/jobs/dl-reference-pipeline.js --source paco --step collect --dry-run --search-keyword pacopaco --max-pages 2",
    "job:dl-reference:paco:collect": "node apps/jobs/dl-reference-pipeline.js --source paco --step collect --search-keyword pacopaco --max-pages 119",
    "job:dl-reference:paco:status": "node apps/jobs/dl-reference-pipeline.js --source paco --step status",
    "job:video-metadata:paco:init-db": "node apps/jobs/collect-video-metadata.js --source paco --step init-db",
    "job:video-metadata:paco:dry-run": "node apps/jobs/collect-video-metadata.js --source paco --step collect --dry-run --limit 10",
    "job:video-metadata:paco:collect": "node apps/jobs/collect-video-metadata.js --source paco --step collect",
    "job:video-metadata:paco:status": "node apps/jobs/collect-video-metadata.js --source paco --step status",
    "api:start": "node apps/api/src/server.js",
    "api:start:paco": "set API_PORT=3103&& node apps/api/src/server.js",
    "web:dev": "npm --workspace @collection-ledger/web run dev",
    "web:build": "npm --workspace @collection-ledger/web run build",
    "job:owned-file:paco:init-db": "node apps/jobs/owned-file-pipeline.js --source paco --step init-db",
    "job:owned-file:paco:plan": "node apps/jobs/owned-file-pipeline.js --source paco --step plan",
    "job:owned-file:paco:dry-run": "node apps/jobs/owned-file-pipeline.js --source paco --step import --dry-run",
    "job:owned-file:paco:import": "node apps/jobs/owned-file-pipeline.js --source paco --step import",
    "job:owned-file:paco:status": "node apps/jobs/owned-file-pipeline.js --source paco --step status",
    "job:move:paco:dry-run": "node apps/jobs/move-paco-files.js --dry-run --query paco --target-name paco",
    "job:move:paco:execute": "node apps/jobs/move-paco-files.js --execute --query paco --target-name paco",
    "job:owned:paco:check-j": "node apps/jobs/check-owned-relations.js --source paco --target-dir J:\\\\uncen\\\\paco",
    "job:owned:paco:unmatched-all": "node apps/jobs/check-owned-relations.js --source paco --all-paco-drives --unmatched-only",
    "job:owned:paco:move-unmatched-all": "node apps/jobs/check-owned-relations.js --source paco --all-paco-drives --unmatched-only --move-unmatched",
    "job:thumb:paco:init-db": "node apps/jobs/collect-paco-thumbnails.js --source paco --step init-db",
    "job:thumb:paco:status": "node apps/jobs/collect-paco-thumbnails.js --source paco --step status",
    "job:thumb:paco:dry-run": "node apps/jobs/collect-paco-thumbnails.js --source paco --step collect --dry-run --limit 10",
    "job:thumb:paco:collect": "node apps/jobs/collect-paco-thumbnails.js --source paco --step collect",
    "job:rename:paco:owned:dry-run": "node apps/jobs/rename-paco-owned-files.js --dry-run --csv",
    "job:rename:paco:owned:execute": "node apps/jobs/rename-paco-owned-files.js --execute --csv",
    "job:rename:paco:owned:rollback": "node apps/jobs/rename-paco-owned-files.js --rollback --manifest"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ffprobe-static": "^3.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "pg": "^8.20.0",
    "puppeteer": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
